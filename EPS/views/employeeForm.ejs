<!DOCTYPE html>
<html>
<head>
    <title>Add Employee</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<h2>Add Employee</h2>

<form action="/api/employees" method="POST">
    <input type="text" name="name" placeholder="Name" required><br><br>
    <input type="email" name="email" placeholder="Email" required><br><br>
    <input type="text" name="department" placeholder="Department" required><br><br>
    <input type="number" name="basicSalary" placeholder="Basic Salary" required><br><br>
    <input type="date" name="joiningDate" required><br><br>

    <button type="submit">Add Employee</button>
</form>

<br>
<a href="/">Back</a>

</body>
</html>